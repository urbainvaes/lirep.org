{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@web/*": ["../frontend/src/*"],
      "chess.js": ["./node_modules/chess.js"],
      "@lichess-org/chessground": ["./node_modules/@lichess-org/chessground"],
      "@lichess-org/chessground/*": ["./node_modules/@lichess-org/chessground/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["src"]
}
