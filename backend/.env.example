LICHESS_CLIENT_ID=lirep-dev
FRONTEND_URL=http://127.0.0.1:5173
REDIRECT_URI=http://127.0.0.1:5173/auth/callback
SESSION_SECRET=change-me-to-a-random-value
# Defaults to whether FRONTEND_URL is https:// — set explicitly (true/false)
# only if this app is deployed behind an HTTPS-terminating proxy that talks
# plain HTTP to it, where the default would otherwise guess wrong.
# SESSION_HTTPS_ONLY=true
# Optional local Lichess Explorer, for example http://127.0.0.1:9002 — see
# explorer/README.md for how to launch it.
LOCAL_LICHESS_EXPLORER_URL=
# Beta limit on the number of users (default 100; 0 = no limit).
# MAX_USERS=100
# Lichess usernames (comma-separated) who may delete any forum post.
# FORUM_ADMINS=
